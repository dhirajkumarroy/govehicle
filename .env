# Application Configuration
PORT=8000
NODE_ENV=development
API_PREFIX=/api/v1

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:Dhiraj123%40%23@localhost:5432/govehicle?schema=public"

# JWT Authentication Configuration
JWT_SECRET="your-super-secret-access-token-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-token-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Bcrypt Security Configuration
BCRYPT_SALT_ROUNDS=12

# Express Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX=100

# Nodemailer Configuration (SMTP Email service)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
SMTP_FROM="GoVehicle <no-reply@govehicle.com>"

# Cloudinary Storage Configuration (Vehicle and profile images)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
